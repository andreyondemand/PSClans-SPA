{
  "name": "psclans-spa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check app.js && node --check API/spa-api.js && node --check API/spa-api.test.js && node scripts/check-static-security.js",
    "test": "node API/spa-api.test.js",
    "worker:dev": "wrangler dev --test-scheduled",
    "worker:dry-run": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply psclans-spa --local"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
